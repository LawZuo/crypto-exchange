<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>coin.exchange</groupId>
        <artifactId>exchange-module</artifactId>
        <version>1.0</version>
    </parent>

    <artifactId>exchange-module-resource</artifactId>
    <packaging>jar</packaging>

    <name>exchange-module-resource</name>
    <description>Resource 子模块统一启动服务</description>

    <dependencies>
        <dependency>
            <groupId>coin.exchange</groupId>
            <artifactId>exchange-resource-mail</artifactId>
            <version>1.0</version>
        </dependency>
        <dependency>
            <groupId>coin.exchange</groupId>
            <artifactId>exchange-resource-upload</artifactId>
            <version>1.0</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
